# DataImpulse residential proxy — copy to dataimpulse.local.env and fill in.
# dataimpulse.local.env is gitignored. NEVER put real credentials in this example file.
DATAIMPULSE_LOGIN=your_login_here
DATAIMPULSE_PASSWORD=your_password_here
